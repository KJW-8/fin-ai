# 오뚝이(Ottugi) — Streamlit secrets 예시 파일.
#
# 로컬에서 실 API 코칭을 테스트하려면 이 파일을 같은 폴더의 secrets.toml로 복사한 뒤
# 값을 채워 넣는다 (secrets.toml은 .gitignore로 커밋에서 제외됨 — API 키가 들어가므로
# 절대 커밋하지 말 것).
#
# Streamlit Community Cloud 배포 시에는 이 파일을 올리지 말고, 앱 대시보드의
# "Settings → Secrets"에 아래 내용을 그대로 붙여넣으면 된다.

# Anthropic API 키 (실 API 코칭을 쓸 때만 필요). https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 코칭 메시지 생성 방식 전환:
#   "true"  → mock (API 호출 없음, 키 불필요, 비용/트래픽 0)
#   "false" → 실제 Claude Haiku 4.5 API 호출 (ANTHROPIC_API_KEY 필요)
USE_MOCK_COACHING = "true"
